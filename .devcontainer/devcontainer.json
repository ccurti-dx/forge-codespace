{
  "name": "Atlassian Forge",
  "image": "atlassian/forge-devcontainer:latest",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "terminal.integrated.shell.linux": "/bin/bash"
      }
    }
  },
  "remoteUser": "node",
  "secrets": {
    "FORGE_EMAIL": {
      "description": "Login email address of the Forge user.",
      "documentationUrl": "http://go.atlassian.com/env-var"
    },
    "FORGE_API_TOKEN": {
      "description": "Account API token created at https://id.atlassian.com/manage/api-tokens",
      "documentationUrl": "http://go.atlassian.com/api-token-login"
    }
  },
  "postCreateCommand": "forge --version && npx --yes skills add atlassian/forge-skills --yes"
}
